# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL
POSTGRES_USER=sanity
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ecosystem_sanity
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Derived — used by the app (SQLAlchemy connection string)
DATABASE_URL=postgresql://sanity:changeme@db:5432/ecosystem_sanity

# Scraper
CRAWL_DELAY=1.0

# Production only — path where Infomaniak block storage is mounted on the host VM
# DATA_DIR=/mnt/data

# LLM Scoring
MISTRAL_API_KEY=your_mistral_api_key_here
