# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL
POSTGRES_USER=sanity
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ecosystem_sanity
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Derived — used by the app (SQLAlchemy connection string)
DATABASE_URL=postgresql://sanity:changeme@db:5432/ecosystem_sanity

# Scraper
CRAWL_DELAY=1.0

# Production only — path where Infomaniak block storage is mounted on the host VM
# DATA_DIR=/mnt/data

# LLM Scoring
MISTRAL_API_KEY=your_mistral_api_key_here

# Fact-Check track (OPTIONAL — the ragebait track runs fine without these).
# Each retrieval backend guards on a missing key: leave a key blank and that
# backend is simply skipped. Set FACTCHECK_ENABLED in src/config.py to turn the
# track on.
# Google Fact Check Tools API — free, daily quota. Enable "Fact Check Tools API"
# in a Google Cloud project, then create an API key.
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
# Tavily web search — free tier ~1000 credits/month. Sign up at app.tavily.com.
TAVILY_API_KEY=your_tavily_api_key_here

# Jelastic deployment / redeploy (ops only — not needed to run the app locally)
# Used to build the GitHub Actions JELASTIC_WEBHOOK_PROD secret and for manual
# redeploys. Generate the token in the Jelastic console → Settings → Access Tokens.
JELASTIC_API_TOKEN=your_jelastic_access_token_here
JELASTIC_PLATFORM_URL=https://app.jpc.infomaniak.com
JELASTIC_ENV_NAME=your-jelastic-env-name
